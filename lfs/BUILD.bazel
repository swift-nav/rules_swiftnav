load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_test.bzl", "py_test")
load("@rules_swiftnav//cc:defs.bzl", "UNIT")
load(":defs.bzl", "lfs_lockfile")

py_binary(
    name = "generate_lockfile",
    srcs = ["generate_lockfile.py"],
    main = "generate_lockfile.py",
    visibility = ["//visibility:public"],
)

py_test(
    name = "generate_lockfile_test",
    srcs = [
        "generate_lockfile.py",
        "generate_lockfile_test.py",
    ],
    main = "generate_lockfile_test.py",
    tags = [UNIT],
)

lfs_lockfile(
    name = "testdata_lockfile",
    srcs = glob(["testdata/*"]),
    gitattributes = "testdata/gitattributes",
    lockfile = "testdata/lfs.lock.json",
    tags = [UNIT],
)
