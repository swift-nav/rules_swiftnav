load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("@rules_swiftnav//cc:defs.bzl", "UNIT")
load(":defs.bzl", "lfs_lockfile")

# Importable as lfs.generate_lockfile whether rules_swiftnav is the main
# repository or a dependency of one.
py_library(
    name = "generate_lockfile_lib",
    srcs = ["generate_lockfile.py"],
    imports = [".."],
)

py_binary(
    name = "generate_lockfile",
    main_module = "lfs.generate_lockfile",
    visibility = ["//visibility:public"],
    deps = [":generate_lockfile_lib"],
)

py_test(
    name = "generate_lockfile_test",
    srcs = ["generate_lockfile_test.py"],
    main = "generate_lockfile_test.py",
    tags = [UNIT],
    deps = [":generate_lockfile_lib"],
)

lfs_lockfile(
    name = "testdata_lockfile",
    srcs = glob(["testdata/*"]),
    gitattributes = "testdata/gitattributes",
    lockfile = "testdata/lfs.lock.json",
    tags = [UNIT],
)
