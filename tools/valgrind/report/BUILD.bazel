# Reporting side of the valgrind tooling: measuring a profiling run, gating
# those measurements against a baseline, and turning the comparisons into a PR
# comment. The valgrind macros and runner scripts live one level up in
# //tools/valgrind.

load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("@rules_swiftnav//cc:defs.bzl", "UNIT")

# Measurement and report types shared by every tool here. Public because the
# generated comparison test compiles compare.py in the consuming package and
# needs this as a dependency.
py_library(
    name = "metrics",
    srcs = ["metrics.py"],
    # This package alone, so every module here is a top-level import. Putting
    # this repository's root on sys.path instead would make the import
    # "tools.valgrind.report.metrics", and any consumer with its own top-level
    # "tools" package would shadow ours and break the import.
    imports = ["."],
    visibility = ["//visibility:public"],
)

py_test(
    name = "metrics_test",
    srcs = ["metrics_test.py"],
    main = "metrics_test.py",
    tags = [UNIT],
    deps = [":metrics"],
)

# Measures a callgrind run's instruction count. Public because the profile rule
# runs it as a tool of the action it generates in the consuming repository.
py_binary(
    name = "callgrind_measure",
    srcs = ["callgrind_measure.py"],
    main = "callgrind_measure.py",
    visibility = ["//visibility:public"],
    deps = [":metrics"],
)

py_test(
    name = "callgrind_measure_test",
    srcs = ["callgrind_measure_test.py"],
    main = "callgrind_measure_test.py",
    tags = [UNIT],
    deps = [
        ":callgrind_measure",
        ":metrics",
    ],
)

# Measures a massif (and DRD) run's memory figures. Public for the same reason
# as callgrind_measure.
py_binary(
    name = "massif_drd_measure",
    srcs = ["massif_drd_measure.py"],
    main = "massif_drd_measure.py",
    visibility = ["//visibility:public"],
    deps = [":metrics"],
)

py_test(
    name = "massif_drd_measure_test",
    srcs = ["massif_drd_measure_test.py"],
    main = "massif_drd_measure_test.py",
    tags = [UNIT],
    deps = [
        ":massif_drd_measure",
        ":metrics",
    ],
)

# Gates a measurement against its baseline, and is the whole of the test the
# valgrind macros generate. Exported rather than only a py_binary because that
# test compiles it as a src in the consuming package, the same way the runner is
# used one level up.
exports_files(
    ["compare.py"],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "compare",
    srcs = ["compare.py"],
    main = "compare.py",
    visibility = ["//visibility:public"],
    deps = [":metrics"],
)

py_test(
    name = "compare_test",
    srcs = ["compare_test.py"],
    main = "compare_test.py",
    tags = [UNIT],
    deps = [
        ":compare",
        ":metrics",
    ],
)

# Merges the reports of any number of profiled targets into one markdown
# comment. Public so CI can `bazel run` it over the collected test outputs.
py_binary(
    name = "pr_comment",
    srcs = ["pr_comment.py"],
    main = "pr_comment.py",
    visibility = ["//visibility:public"],
    deps = [":metrics"],
)

py_test(
    name = "pr_comment_test",
    srcs = ["pr_comment_test.py"],
    main = "pr_comment_test.py",
    tags = [UNIT],
    deps = [
        ":metrics",
        ":pr_comment",
    ],
)
