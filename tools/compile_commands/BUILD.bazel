load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_swiftnav//cc:defs.bzl", "UNIT")

package(default_visibility = ["//visibility:public"])

exports_files([
    "bazel_wrapper.sh",
])

# Host-only dev tool. `manual` keeps it out of `//...`, which may be built for
# cross-compilation platforms that have no prebuilt bcc binary.
alias(
    name = "compile_commands",
    actual = select(
        {
            "@bazel_tools//src/conditions:linux_x86_64": "@bcc_linux_x86_64//:bcc_bin",
            "@bazel_tools//src/conditions:darwin_arm64": "@bcc_macos_arm64//:bcc_bin",
        },
        no_match_error = "Hermetic BCC is only available on linux_x86_64 and darwin_arm64. " +
                         "darwin_x86_64 (Intel macOS) and other hosts are not supported.",
    ),
    tags = ["manual"],
)

# Importable as tools.compile_commands.resolve_virtual_includes from the
# repository root, whether rules_swiftnav is the main repository or a dependency
# of one.
py_library(
    name = "resolve_virtual_includes_lib",
    srcs = ["resolve_virtual_includes.py"],
    imports = ["../.."],
)

# Host-only dev tool of refresh. resolve_virtual_includes_test covers its code
# in `//...`.
py_binary(
    name = "resolve_virtual_includes",
    srcs = ["resolve_virtual_includes.py"],
    tags = ["manual"],
)

py_test(
    name = "resolve_virtual_includes_test",
    srcs = ["resolve_virtual_includes_test.py"],
    data = ["testdata/aquery_symlinks.json"],
    main = "resolve_virtual_includes_test.py",
    tags = [UNIT],
    target_compatible_with = select({
        "@platforms//os:linux": ["@platforms//cpu:x86_64"],
        "@platforms//os:macos": ["@platforms//cpu:aarch64"],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":resolve_virtual_includes_lib"],
)

sh_binary(
    name = "refresh",
    srcs = ["refresh.sh"],
    args = [
        "--bcc=$(rootpath :compile_commands)",
        "--resolve-virtual-includes=$(rootpath :resolve_virtual_includes)",
    ],
    data = [
        ":compile_commands",
        ":resolve_virtual_includes",
    ],
    tags = ["manual"],
)
